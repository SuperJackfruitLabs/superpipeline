    "sql": [
      "SELECT v FROM meta WHERE k = ?  <-  ["boardId"]",
      "SELECT v FROM meta WHERE k = ?  <-  ["intro"]",
      "SELECT v FROM meta WHERE k = ?  <-  ["tenantId"]",
      "SELECT v FROM meta WHERE k = ?  <-  ["name"]",
      "SELECT v FROM meta WHERE k = ?  <-  ["stages"]",
      "SELECT card_id, COALESCE(SUM(cost_usd), 0) AS c FROM usage_records GROUP BY card_id",
      "SELECT card_id, COUNT(*) AS n FROM runs GROUP BY card_id",
      "SELECT r.card_id, r.agent_id FROM runs r WHERE r.id = (SELECT x.id FROM runs x WHERE x.card_id = r.card_id ORDER BY x.started_at DESC, x.id DESC LIMIT 1)",
      "SELECT to_card_id, from_card_id FROM card_links WHERE kind = 'parent'",
      "SELECT l.from_card_id AS parent_id, COUNT(*) AS n FROM card_links l JOIN cards ch ON ch.id = l.to_card_id WHERE l.kind = 'parent' AND ch.state NOT IN ('completed', 'canceled') GROUP BY l.from_card_id",
      "SELECT l.from_card_id AS parent_id, COALESCE(SUM(u.cost_usd), 0) AS c FROM card_links l JOIN usage_records u ON u.card_id = l.to_card_id WHERE l.kind = 'parent' GROUP BY l.from_card_id",
      "SELECT l.to_card_id AS blocked_id, b.id AS blocker_id, b.title AS blocker_title FROM card_links l JOIN cards b ON b.id = l.from_card_id WHERE l.kind = 'blocks' AND b.state NOT IN ('completed', 'canceled')",
      "SELECT * FROM cards ORDER BY priority DESC, (due_at IS NULL), due_at ASC, created_at ASC",
      "SELECT v FROM meta WHERE k = ?  <-  ["budgetCardUsdCap"]",
      "SELECT * FROM gates WHERE status = 'pending' AND card_id NOT IN (SELECT id FROM cards WHERE archived_at IS NOT NULL) ORDER BY created_at ASC",
      "SELECT * FROM elicitations WHERE status = 'pending' AND card_id NOT IN (SELECT id FROM cards WHERE archived_at IS NOT NULL) ORDER BY created_at ASC, rowid ASC",
      "SELECT * FROM card_references ORDER BY created_at ASC",
      "SELECT COALESCE(SUM(cost_usd), 0) AS cost, COALESCE(SUM(CASE WHEN estimated = 1 THEN cost_usd ELSE 0 END), 0) AS est, COALESCE(SUM(input_tokens), 0) AS itok, COALESCE(SUM(output_tokens), 0) AS otok FROM usage_records",
      "SELECT COUNT(*) AS n FROM usage_records WHERE estimated = 1 AND cost_usd = 0",
      "SELECT COALESCE(model, '(unknown)') AS model, SUM(cost_usd) AS cost, SUM(input_tokens) AS itok, SUM(output_tokens) AS otok FROM usage_records GROUP BY model ORDER BY cost DESC",
      "SELECT agent_id, SUM(cost_usd) AS cost FROM usage_records GROUP BY agent_id ORDER BY cost DESC",
      "SELECT card_id, SUM(cost_usd) AS cost FROM usage_records GROUP BY card_id ORDER BY cost DESC",
      "SELECT substr(ts, 1, 10) AS day, SUM(cost_usd) AS c FROM usage_records WHERE ts >= ? GROUP BY day  <-  ["2030-12-26T00:00:00Z"]",
