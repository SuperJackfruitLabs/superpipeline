      "SELECT l.from_card_id AS parent_id, COALESCE(SUM(u.cost_usd), 0) AS c FROM card_links l JOIN usage_records u ON u.card_id = l.to_card_id WHERE l.kind = 'parent' GROUP BY l.from_card_id",
