{
  "name": "@superpipeline/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "test:pixel": "playwright test -c e2e/pixel/playwright.pixel.config.ts",
    "test:refs": "playwright test -c e2e/pixel/playwright.refs.config.ts",
    "test:pixel:report": "open test-results/pixel/index.html",
    "visual:local": "bash scripts/visual/base-vs-head.sh HEAD~1",
    "visual:self": "VISUAL_SELF=1 bash scripts/visual/base-vs-head.sh"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^2.0.1",
    "@superjackfruit/vibekit": "file:./vendor/vibekit-0.0.12.tgz",
    "@superpipeline/contract": "workspace:*",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/azeret-mono": "5.3.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "5.3.0",
    "@playwright/test": "^1.61.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.66.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/pngjs": "^6.0.5",
    "jsdom": "^30.1.2",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.1",
