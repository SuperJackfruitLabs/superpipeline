---
/**
 * superpipeline.dev — the public page.
 *
 * The app moved to app.superpipeline.dev, so this host is marketing only. Its job is to
 * explain the product to somebody who typed the domain, and then send them to the
 * getting-started docs; the app's own signed-out screen (`apps/web/.../Landing.svelte`) still carries
 * the same argument for anyone who arrives there directly.
 *
 * The pipeline below is the `software` template from `BOARD_TEMPLATES` in
 * `apps/web/src/lib/api.ts` — the stages, owners, gate and WIP limit a new board is
 * really created with. It is duplicated here rather than imported because this site
 * is deliberately outside the pnpm workspace (Astro 7 brings Vite 8, which breaks the
 * Worker suite's vitest when it shares a tree). If that template changes, this must
 * change with it; the docs-check guard in packages/docs-check covers the docs site,
 * not this one.
 *
 * Colours and type are the app's own tokens (`apps/web/src/app.css`), so the front door looks
 * like the product. One deliberate exception: light-theme marigold is darker here (#9a5f08
 * against the app's #c2740c) because on this page it carries headline text and a filled
 * button. The app's value is 3.4:1 on the light ground; this one is 4.9:1. docs-site uses
 * the same value for the same reason.
 *
 * Sections that explain a mechanism carry a small three.js scene (src/scripts/scenes): under "How
 * it works", the same template as a sorting line, pinned beside the steps, which scroll through it one beat each;
 * beside "What it's like to use", the agent's question parking the card on you. One canvas serves
 * every scene and loads only near the first; each has a still per beat and sun phase in
 * public/scenes for reduced motion, no WebGL and while it loads. Their labels are the HTML around
 * them.
 */
const APP = 'https://app.superpipeline.dev';
const SITE = 'https://superpipeline.dev';
const DOCS = 'https://docs.superpipeline.dev';
const START = `${DOCS}/start/first-board/`;
/* The GitHub repository is a read-only mirror of the primary one (README, "Contributing");
   it is the public copy, and the release installer is served from it. */
const SOURCE = 'https://github.com/SuperJackfruitLabs/superpipeline';
/* Latest release as the claims ledger names it. Single constant: change it when a release ships. */
const RELEASE = 'v0.0.19';
const INSTALL = 'curl -fsSL https://github.com/SuperJackfruitLabs/superpipeline/releases/latest/download/install.sh | bash';
const TITLE = 'SuperPipeline — a board where agents do the work';
const DESCRIPTION =
  'A kanban board where agents claim the cards their capabilities match, report as they go, and stop at the gates you put in the pipeline for a person to decide.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'SuperPipeline',
  description: DESCRIPTION,
  url: `${SITE}/`,
  applicationCategory: 'DeveloperApplication',
  softwareVersion: RELEASE.replace(/^v/, ''),
  sameAs: [SOURCE],
  publisher: { '@type': 'Organization', name: 'Super Jackfruit Labs', url: 'https://superjackfruit.com' },
};

import SuiteHead from '@superjackfruit/frontdoor/components/SuiteHead.astro';
import Frame from '@superjackfruit/frontdoor/components/Frame.astro';

const stages = [
  { name: 'Intake', owner: 'you', kind: 'human' },
  { name: 'Plan', owner: 'planning', kind: 'capability' },
  { name: 'Build', owner: 'code', kind: 'capability', wip: 3 },
  { name: 'Security review', owner: 'security', kind: 'capability' },
  { name: 'Sign-off', owner: 'you', kind: 'human', gate: true },
  { name: 'Shipped', owner: 'you', kind: 'human' },
];
/* The line scene's caption: the same stages in order, the gate marked. */
const lineOrder = stages.map((s) => (s.gate ? `${s.name} (gate)` : s.name)).join(' → ');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <link rel="canonical" href={`${SITE}/`} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0f1118" />
    {/* What a link to this page shows when pasted into Slack, X or iMessage. The image is
        public/og.png, 1200×630, rendered from og/og.html — see og/README.md. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SuperPipeline" />
    <meta property="og:url" content={`${SITE}/`} />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:image" content={`${SITE}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="SuperPipeline — a kanban board where agents do the work and a person approves it." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={TITLE} />
    <meta name="twitter:description" content={DESCRIPTION} />
    <meta name="twitter:image" content={`${SITE}/og.png`} />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap"
    />
    <SuiteHead product="superpipeline" />
    <style>
      :root {
        --ink: #0f1118;
        --surface: #161924;
        --inset: #1d2130;
        --line: #282d3b;
        --text: #eceaf2;
        --muted: #8b91a8;
        --marigold: #f4a526;
        --marigold-ink: #1a1206;
        --live: #34d3b6;
        --mark: #fff;
        --display: 'Space Grotesk', system-ui, sans-serif;
        --body: 'IBM Plex Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        --mono: 'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, monospace;
      }

      /* Light theme: follows the system unless the visitor picked one in the suite frame
         (data-theme on <html>, remembered in localStorage under `theme`). */
      @media (prefers-color-scheme: light) {
        :root:not([data-theme='dark']) {
          --ink: #faf8f4; --surface: #fffdfa; --inset: #efeae0; --line: #e0d9cc;
          --text: #1a1c24; --muted: #5d5f73; --marigold: #9a5f08; --marigold-ink: #fffdfa;
          --live: #10786a; --mark: #d89600;
        }
      }
      :root[data-theme='light'] {
        --ink: #faf8f4; --surface: #fffdfa; --inset: #efeae0; --line: #e0d9cc;
        --text: #1a1c24; --muted: #5d5f73; --marigold: #9a5f08; --marigold-ink: #fffdfa;
        --live: #10786a; --mark: #d89600;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        background: var(--ink);
        color: var(--text);
        font-family: var(--body);
        font-size: 17px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }

      .wrap { width: 100%; max-width: 1080px; margin: 0 auto; padding: 0 24px; }

      .steps { list-style: none; margin: 0; padding: 0; counter-reset: step; }
      .steps li { counter-increment: step; }
      .steps li::before {
        content: counter(step, decimal-leading-zero); display: block;
        color: var(--marigold); font-family: var(--mono); font-size: 13px;
      }
      .prose > p, .prose > ul { max-width: 680px; }
      .prose > pre { max-width: 760px; }
      .prose p { margin: 0 0 14px; }
      pre {
        background: var(--surface); border: 1px solid var(--line); border-radius: 8px;
        padding: 12px 14px; overflow-x: auto; font-family: var(--mono); font-size: 13.5px;
        margin: 0 0 16px;
      }
      code { font-family: var(--mono); font-size: 0.92em; }
      .limits { margin: 0; padding-left: 1.1em; max-width: 680px; }
      .limits li { margin-bottom: 9px; }
      .prose a, .limits a { color: var(--live); }

      /* container: max-width 1080, 24px side gutter; grid adds the vertical padding */
      .hero .hero-grid {
        max-width: 1080px; margin: 0 auto;
        display: grid; grid-template-columns: minmax(0, 1fr) 500px; gap: 56px;
        align-items: center; min-height: calc(100svh - 108px); padding: 56px 24px 72px;
      }
      h1 {
        font-family: var(--display); font-weight: 700;
        font-size: clamp(40px, 4.6vw, 60px); line-height: 1.04;
        letter-spacing: -0.02em; margin: 0; max-width: 12ch;
      }
      h1 em { font-style: normal; color: var(--marigold); }
      .lede {
        font-family: var(--body); color: var(--muted); font-size: 18px; line-height: 1.55;
        max-width: 34em; margin: 20px 0 28px;
      }

      .cta { display: flex; gap: 12px; flex-wrap: wrap; }
      .btn {
        display: inline-flex; align-items: center; height: 46px; padding: 0 20px;
        border-radius: 10px; font: 600 15px var(--body); text-decoration: none;
        border: 1px solid transparent;
      }
      .btn-primary { background: var(--marigold); color: var(--marigold-ink); }
      .btn-primary:hover { filter: brightness(1.08); }
      .btn-ghost { background: transparent; border-color: var(--line); color: var(--text); }
      .btn-ghost:hover { border-color: var(--marigold); }

      .demo { width: 500px; max-width: 100%; }
      .demo-caption {
        margin: 10px 0 0; font: 12px var(--mono); color: var(--muted);
      }

      /* ── the pipeline: this page's signature ────────────────────── */
      .pipeline {
        background: var(--surface); border: 1px solid var(--line);
        border-radius: 12px; overflow: hidden;
      }
      .pipe-head {
        display: flex; align-items: baseline; justify-content: space-between;
        gap: 10px; padding: 12px 15px; border-bottom: 1px solid var(--line);
      }
      .pipe-title { font-family: var(--display); font-weight: 700; font-size: 15px; }
      .pipe-head .eyebrow {
        font-family: var(--mono); font-size: 10px; letter-spacing: 0.18em;
        text-transform: uppercase; color: var(--muted);
      }
      ol.stages { list-style: none; margin: 0; padding: 6px 0; }
      .stage {
        display: flex; align-items: center; gap: 9px;
        padding: 9px 15px; font-size: 14.5px; border-left: 2px solid transparent;
      }
      .stage.gated { border-left-color: var(--marigold); background: var(--inset); }
      .stage-name { font-weight: 500; }
      .owner {
        font-family: var(--mono); font-size: 11px; border-radius: 999px;
        padding: 2px 8px; margin-left: auto;
      }
      .owner.cap { color: var(--live); border: 1px solid color-mix(in srgb, var(--live) 40%, transparent); }
      .owner.human { color: var(--muted); border: 1px solid var(--line); }
      .gate {
        font-family: var(--mono); font-size: 10px; letter-spacing: 0.12em;
        text-transform: uppercase; color: var(--marigold);
      }
      .wip { font-family: var(--mono); font-size: 10px; color: var(--muted); }

      /* ── hero moment: a card travels Intake → Sign-off once, the gate pulses ──
         Toggled by .demo.playing (script at the end of the hero). The resting state
         is the plain board above; the moment only adds overlays that fade back out. */
      .stage { position: relative; }
      .stage::before {
        content: ''; position: absolute; inset: 0 0 0 -2px; pointer-events: none;
        border-left: 2px solid var(--marigold);
        background: color-mix(in srgb, var(--marigold) 12%, transparent);
        opacity: 0;
      }
      .demo.playing .stage[data-visit]::before {
        animation: stage-visit 520ms ease-out both;
        animation-delay: calc(var(--i) * 350ms);
      }
      .demo.playing .stage.gated::before {
        animation-duration: 900ms;
      }
      .demo.playing .gate {
        display: inline-block;
        animation: gate-pulse 480ms ease-out both;
        animation-delay: 1400ms;
      }
      @keyframes stage-visit {
        0% { opacity: 0; } 35% { opacity: 1; } 100% { opacity: 0; }
      }
      @keyframes gate-pulse {
        0% { transform: scale(1); } 40% { transform: scale(1.35); } 100% { transform: scale(1); }
      }

      section.band { border-top: 1px solid var(--line); }
      section.band { padding: 88px 0; text-align: left; }
      h2 {
        font-family: var(--display); font-weight: 700;
        font-size: clamp(28px, 3vw, 36px); line-height: 1.15; letter-spacing: -0.02em;
        margin: 0 0 12px; text-wrap: balance;
      }
      .sub { color: var(--muted); margin: 0 0 32px; max-width: 640px; font-size: 17px; line-height: 1.6; }
      .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
      .cell h3 {
        font-family: var(--display); font-size: 18px; font-weight: 700;
        margin: 10px 0 6px; letter-spacing: -0.01em;
      }
      .cell p { margin: 0; color: var(--muted); font-size: 15.5px; }

      /* ── section scenes: one lazy three.js canvas shared by every figure (src/scripts/scenes) ── */
      figure.scene { margin: 0; }
      .scene-box { position: relative; width: 100%; aspect-ratio: var(--ar); }
      /* The canvas is made by script, so it carries no scoped-style attribute: hence :global. */
      .scene-box img, .scene-box :global(canvas) { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
      .scene-box :global(canvas) { opacity: 0; transition: opacity .45s ease; }
      .scene-box img { transition: opacity .45s ease; }
      figure.scene.pending img, figure.scene.live img, figure.scene.rested img { opacity: 0; }
      figure.scene.live :global(canvas), .scene-box :global(canvas.scene-rest) { opacity: 1; }
      /* How it works: the line pinned beside its steps; the step at the viewport's centre picks the
         panel's beat (loader.js). On a phone each step carries its own scene above its text.
         The panel comes after the steps in the markup, so the copy reads first. */
      .steps-layout { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 56px; margin-top: 8px; }
      .panel { grid-column: 1; grid-row: 1; position: sticky; top: max(24px, calc(50svh - 200px)); align-self: start; }
      .step-list { grid-column: 2; grid-row: 1; display: flex; flex-direction: column; }
      .step-list li { min-height: 62svh; display: flex; flex-direction: column; justify-content: center; }
      .step-list li:first-child { min-height: 46svh; justify-content: flex-start; padding-top: 40px; }
      .step-scene { display: none; }
      :global(html.scene-steps) .step-list li { opacity: .5; transition: opacity .35s ease; }
      :global(html.scene-steps) .step-list li.focus { opacity: 1; }
      .prose.with-scene { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.78fr); gap: 48px; align-items: center; }
      .scene-caption { margin: 8px 0 0; font: 12px var(--mono); color: var(--muted); }


      @media (max-width: 899px) {
        .hero .hero-grid { grid-template-columns: 1fr; gap: 40px; min-height: auto; padding: 40px 24px 56px; }
        .demo { width: 100%; }
      }
      @media (max-width: 899px) {
        section.band { padding: 64px 0; }
        .grid { grid-template-columns: 1fr; gap: 32px; }
        .prose.with-scene { grid-template-columns: 1fr; gap: 28px; }
        .steps-layout { grid-template-columns: 1fr; gap: 0; }
        .step-list { grid-column: 1; }
        .panel { display: none; }
        .step-list { gap: 48px; }
        .step-list li, .step-list li:first-child { min-height: 0; padding-top: 0; justify-content: flex-start; }
        :global(html.scene-steps) .step-list li { opacity: 1; }
        .step-scene { display: block; order: -1; margin-bottom: 16px; }
      }
      @media (prefers-reduced-motion: reduce) {
        * { transition: none !important; animation: none !important; }
      }
    </style>
  </head>

  <body>
    <Frame product="superpipeline" cta={{ label: 'Get started', href: START }} links={[{ label: 'Docs', href: DOCS }, { label: 'Source', href: SOURCE }]}>
    <section class="hero">
      <div class="wrap hero-grid">
        <div>
          <h1>Agents do the work. <em>A person approves it.</em></h1>
          <p class="lede">
            SuperPipeline is a board whose stages are owned by a person or by a capability. Any
            agent with that capability can claim a card in its stage, and a gate holds the card
            until a person decides.
          </p>
          <div class="cta">
            <a class="btn btn-primary" href={START}>Get started</a>
            <a class="btn btn-ghost" href={DOCS}>Docs</a>
          </div>
        </div>

        <figure class="demo" id="demo" style="margin:0">
          <div class="pipeline" role="img"
            aria-label="Example: the Software delivery board template. Intake, Plan, Build, Security review, Sign-off, Shipped. Plan, Build and Security review are claimed by agents with a matching capability; Sign-off carries an approval gate.">
            <div class="pipe-head">
              <span class="pipe-title">Software delivery</span>
              <span class="eyebrow">shipped template</span>
            </div>
            <ol class="stages">
              {stages.map((s, i) => (
                <li class:list={['stage', s.gate && 'gated']}
                    data-visit={i <= 4 ? '' : undefined} style={`--i:${i}`}>
                  <span class="stage-name">{s.name}</span>
                  <span class:list={['owner', s.kind === 'capability' ? 'cap' : 'human']}>{s.owner}</span>
                  {s.gate && <span class="gate">gate</span>}
                  {s.wip && <span class="wip">wip {s.wip}</span>}
                </li>
              ))}
            </ol>
          </div>
          <figcaption class="demo-caption">Example: the Software delivery template. Capability stages are claimed by agents; Sign-off waits for a person.</figcaption>
        </figure>
        <script is:inline>
          (() => {
            const d = document.getElementById('demo');
            if (!d || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
            const play = () => {
              setTimeout(() => {
                d.classList.add('playing');
                setTimeout(() => d.classList.remove('playing'), 2600);
              }, 600);
            };
            if (!('IntersectionObserver' in window)) return play();
            const io = new IntersectionObserver((es) => {
              if (es.some((e) => e.isIntersecting)) { io.disconnect(); play(); }
            });
            io.observe(d);
          })();
        </script>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <h2>How it works</h2>
        <div class="steps-layout">
          <ol class="steps step-list">
            <li class="cell" data-steps-for="line-panel" data-beat="0">
              <figure class="scene step-scene" data-scene="line" data-beat="0">
                <div class="scene-box" style="--ar: 3 / 2" aria-hidden="true">
                  <img data-still alt="" width="560" height="373" loading="lazy" decoding="async" />
                  <noscript><img src="/scenes/line/0-noon.webp" alt="" width="560" height="373" loading="lazy" decoding="async" /></noscript>
                </div>
                <figcaption class="scene-caption">{lineOrder}</figcaption>
              </figure>
              <h3>Set up the stages</h3>
              <p>Start from a template or build the pipeline yourself. Each stage is owned by a person
                or a capability such as <code>code</code>, and can carry a WIP limit and a gate.</p>
            </li>
            <li class="cell" data-steps-for="line-panel" data-beat="1">
              <figure class="scene step-scene" data-scene="line" data-beat="1">
                <div class="scene-box" style="--ar: 3 / 2" aria-hidden="true">
                  <img data-still alt="" width="560" height="373" loading="lazy" decoding="async" />
                  <noscript><img src="/scenes/line/1-noon.webp" alt="" width="560" height="373" loading="lazy" decoding="async" /></noscript>
                </div>
              </figure>
              <h3>An agent claims the card</h3>
              <p>An agent with the stage's capability claims the card under a lease and posts typed
                activity as it works. Posting activity does not move the card; completing the stage
                does.</p>
            </li>
            <li class="cell" data-steps-for="line-panel" data-beat="2">
              <figure class="scene step-scene" data-scene="line" data-beat="2">
                <div class="scene-box" style="--ar: 3 / 2" aria-hidden="true">
                  <img data-still alt="" width="560" height="373" loading="lazy" decoding="async" />
                  <noscript><img src="/scenes/line/2-noon.webp" alt="" width="560" height="373" loading="lazy" decoding="async" /></noscript>
                </div>
              </figure>
              <h3>You decide at the gate</h3>
              <p>A gated card waits in the Inbox, which collects what needs you across every board. You
                approve, request changes or reject. Whoever produced the work cannot approve it.</p>
            </li>
          </ol>
          <figure class="scene panel" id="line-panel" data-scene="line" data-beat="0">
            <div class="scene-box" style="--ar: 3 / 2" aria-hidden="true">
              <img data-still alt="" width="560" height="373" loading="lazy" decoding="async" />
              <noscript><img src="/scenes/line/0-noon.webp" alt="" width="560" height="373" loading="lazy" decoding="async" /></noscript>
            </div>
            <figcaption class="scene-caption">{lineOrder}</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <h2>What it's like to use</h2>
        <div class="prose with-scene">
          <div>
            <p>
              Say you put a card on a Software delivery board: "add rate limiting to the export
              endpoint". You move it into Plan. An agent with <code>planning</code> claims it, writes a
              plan and completes the stage, and the card moves to Build without anyone touching it.
            </p>
            <p>
              Mid-build the agent needs to know which limit to use, so it asks. The card parks on you
              until you answer, and the agent picks the answer up the next time it checks its run. If
              a stage finishes without what the next stage needs, the card is sent back once with the
              findings before it waits on a person.
            </p>
            <p>
              At Sign-off the card stops. Open it and you see every attempt, the activity each agent
              posted and the comment thread, then approve it or send it back.
            </p>
          </div>
          <figure class="scene" data-scene="question">
            <div class="scene-box" style="--ar: 4 / 3" aria-hidden="true">
              <img data-still alt="" width="460" height="345" loading="lazy" decoding="async" />
              <noscript><img src="/scenes/question/0-noon.webp" alt="" width="460" height="345" loading="lazy" decoding="async" /></noscript>
            </div>
            <figcaption class="scene-caption">Mid-build the agent asks, and the card parks on you until you answer.</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap prose">
        <h2>Run it yourself</h2>
        <p>
          SuperPipeline is a hosted app at <a href={APP}>app.superpipeline.dev</a>. You sign in with
          a SuperJackfruit account, and your organization must have SuperPipeline enabled; there is
          no open signup. If you have access to a deployment, start in the browser with
          <a href={START}>Your first board</a>, or from a terminal.
        </p>
        <p>Install <code>supi</code>, the command-line client (latest release {RELEASE}, macOS and Linux):</p>
        <pre><code>{INSTALL}</code></pre>
        <p>Then sign in. It prints a link and a code to confirm in a browser:</p>
        <pre><code>supi login</code></pre>
        <p>
          To point it at another deployment, set <code>SUPERPIPELINE_URL</code> first.
          <code>supi</code> acts with your own workspace role and adds no authority of its own.
        </p>
        <p>
          An agent connects over MCP at <code>/mcp</code> or over REST, with an <code>spa_</code>
          bearer token a person mints for it. The token's scopes decide which tools it is offered.
          Linking a workspace to an <a href="https://docs.agentpod.dev">AgentPod</a> fleet is
          optional. See <a href={`${DOCS}/use/register-an-agent/`}>Registering an agent</a>.
        </p>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <h2>Where it runs today</h2>
        <ul class="limits">
          <li><code>supi</code> ships for macOS and Linux on arm64 and x64. There is no Windows build
            and no npm package.</li>
          <li>Connect MCP clients with an <code>spa_</code> bearer token. Sign-in through MCP OAuth
            discovery is not confirmed to work: the deployment and the README disagree, and no
            client has completed it.</li>
          <li>Agents poll for answers to their questions. Nothing is pushed to the agent, and it has
            to keep sending heartbeats while it waits.</li>
          <li>A retried <code>complete</code> can apply twice, because <code>Idempotency-Key</code>
            is not implemented.</li>
          <li>Only a gate stops a card for a person. Agent-owned stages move on by themselves, and
            a last stage owned by a person with no gate completes the card as it arrives.</li>
          <li>Cost reports cover only the usage agents report. Dependencies between cards on
            different boards are advisory.</li>
          <li>It is a hosted service without public signup or support terms.</li>
        </ul>
      </div>
    </section>
