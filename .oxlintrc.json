{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "node",
    "promise",
    "vitest"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/switch-exhaustiveness-check": [
      "error",
      {
        "considerDefaultExhaustiveForUnions": true
      }
    ],
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "no-empty": [
      "error",
      {
        "allowEmptyCatch": false
      }
    ],
    "no-console": "error",
    "no-unused-vars": [
      "error",
      {
        "ignoreRestSiblings": true,
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ]
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/.svelte-kit/**",
    "**/build/**",
    "**/test-results/**",
    "docs-site/**",
    "landing/**",
    "apps/web/vendor/**",
    "apps/web/static/**",
    "apps/web/src/lib/vendor/**",
    "packages/cli/src/skill-embedded.ts"
  ],
  "overrides": [
    {
      "files": [
        "scripts/**",
        "apps/web/scripts/**",
        "apps/web/e2e/**",
        "packages/cli/src/**",
        "packages/docs-check/src/**",
        "**/*.test.ts"
      ],
      "rules": {
        "no-console": "off"
      }
    }
  ]
}
