{
  "name": "superpipeline",
  "version": "0.0.1",
  "private": true,
  "description": "A multi-tenant Kanban board that orchestrates external AI agents through pipeline stages with human approval gates.",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm -r test && pnpm test:architecture",
    "test:architecture": "vitest run --config scripts/vitest.config.mjs",
    "typecheck": "pnpm -r typecheck",
    "lint": "node scripts/lint.mjs",
    "build": "pnpm -r build",
    "ci:build-app": "node scripts/app-artifact.mjs build",
    "ci:verify-app": "node scripts/app-artifact.mjs verify",
    "ci:deploy-app": "node scripts/app-artifact.mjs deploy",
    "ci:test": "node --test scripts/*.test.mjs"
  },
  "devDependencies": {
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
